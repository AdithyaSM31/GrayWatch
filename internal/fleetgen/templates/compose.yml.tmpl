# Generated by fleetgen. Do not edit.
name: graywatch

services:
  postgres:
    image: postgres:16
    command: postgres -c max_connections=300
    environment:
      POSTGRES_PASSWORD: gw

  dep:
    image: graywatch/app
    build: ..
    command: /dep
    container_name: dep
{{range .Hosts}}
  {{.}}:
    image: graywatch/app
    build: ..
    container_name: {{.}}
    hostname: {{.}}
    labels:
      graywatch.role: app
    cpus: 0.5
    mem_limit: 512m
    volumes:
      - ./data/{{.}}:/data
    environment:
      HEALTH_MODE: {{$.HealthMode}}
      DB_URL: postgres://postgres:gw@postgres:5432/postgres?sslmode=disable
    depends_on:
      - postgres
      - dep
{{end}}
  haproxy:
    image: haproxy:2.8
    volumes:
      - ./haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
    ports:
      - "8000:8000"
      - "127.0.0.1:9999:9999"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
{{- range .Hosts}}
      - {{.}}
{{- end}}

  # The dashboard is opt-in: docker compose --profile dashboard up -d
  # The benchmark's results come from a fleet without it.
  prometheus:
    image: prom/prometheus:v2.53.0
    profiles: [dashboard]
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"

  grafana:
    image: grafana/grafana:11.1.0
    profiles: [dashboard]
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/graywatch.json:/var/lib/grafana/dashboards/graywatch.json:ro
    depends_on:
      - prometheus
