# Generated by fleetgen. Do not edit.
name: graywatch

services:
  postgres:
    image: postgres:16
    command: postgres -c max_connections=300
    environment:
      POSTGRES_PASSWORD: gw

  dep:
    image: graywatch/app
    build: ..
    command: /dep
    container_name: dep
{{range .Hosts}}
  {{.}}:
    image: graywatch/app
    build: ..
    container_name: {{.}}
    hostname: {{.}}
    labels:
      graywatch.role: app
    cpus: 0.5
    mem_limit: 512m
    volumes:
      - ./data/{{.}}:/data
    environment:
      HEALTH_MODE: {{$.HealthMode}}
      DB_URL: postgres://postgres:gw@postgres:5432/postgres?sslmode=disable
    depends_on:
      - postgres
      - dep
{{end}}
  haproxy:
    image: haproxy:2.8
    volumes:
      - ./haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
    ports:
      - "8000:8000"
      - "127.0.0.1:9999:9999"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
{{- range .Hosts}}
      - {{.}}
{{- end}}
